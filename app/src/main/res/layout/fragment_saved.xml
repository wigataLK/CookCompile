<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Header: Title + Hapus Semua -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resep Tersimpan"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Hapus Semua Badge Button -->
            <TextView
                android:id="@+id/btnDeleteAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_destructive"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="Hapus Semua"
                android:textColor="@color/destructive_text"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Subtitle Info -->
        <TextView
            android:id="@+id/tvSavedSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="5 favorit tersimpan • Klik ikon hijau untuk batal simpan:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Saved List Container -->
        <LinearLayout
            android:id="@+id/layoutSavedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSavedRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_recipe_vertical" />

            <!-- Bottom CTA: + Tambah dari Resep di Beranda -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMore"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="@color/primary_light"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+ Tambah dari 1.000+ Resep di Beranda"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/primary_light" />

        </LinearLayout>

        <!-- Empty State Container (AS 05C) -->
        <LinearLayout
            android:id="@+id/layoutEmptySaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <!-- Circular Bookmark Icon -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_empty_circle">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/text_muted"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Belum Ada Resep Tersimpan"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Anda dapat menyimpan maupun membatalkan simpanan resep kapan saja dari halaman Beranda atau Detail Resep."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Primary Action: Jelajahi Resep di Beranda -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExploreHome"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Jelajahi Resep di Beranda"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- Secondary Action: Tampilkan Kembali 5 Favorit Awal -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestoreInitial"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary_light"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Tampilkan Kembali 5 Favorit Awal"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/primary_light" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
