<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CookCompileAPP" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.CookCompileAPP" parent="Base.Theme.CookCompileAPP" />

    <style name="Theme.CookCompileAPP.Fullscreen" parent="Theme.CookCompileAPP">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ShapeAppearance.CookCompile.RoundedImage" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.CookCompile.CircleAvatar" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.CookCompile.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_light</item>
        <item name="android:width">60dp</item>
        <item name="android:height">32dp</item>
    </style>
</resources>
